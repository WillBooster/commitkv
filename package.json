{
  "name": "commitkv",
  "version": "0.0.0-semantically-released",
  "description": "Compressed key-value store for git-managed caches: append-only segments that never exceed a size limit, usable from Python, Node.js, and Bun",
  "keywords": [
    "cache",
    "compression",
    "git",
    "key-value",
    "zstd"
  ],
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/commitkv.git"
  },
  "files": [
    "dist/",
    "native/"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run build/native && bun run build/types",
    "build/native": "bun scripts/buildNative.ts",
    "build/types": "build-ts lib --input src/index.ts --module-type esm",
    "cleanup": "bun wb lint --fix --format",
    "common/ci-setup": "bun run setup-uv",
    "format": "bun wb lint --format && bun run format-code",
    "format-code": "uv run isort --profile black python test && uv run black python test",
    "lint": "uv run flake8 python test && bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "release": "wb release",
    "setup-uv": "uv sync --frozen",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "test/ci-setup": "bun run build/native && uv sync --frozen",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.3",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "22.29.3",
    "build-ts": "21.0.27",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.2.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "semantic-release": "25.0.9"
  }
}
